{
  "name": "@nabothdaniel/express-auto-doc-ts",
  "version": "1.1.1",
  "description": "Automatically generate OpenAPI/Swagger documentation from Express routes with TypeScript support",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nabothdaniel/Auto-swagger-project.git"
  },
  "bugs": {
    "url": "https://github.com/Nabothdaniel/Auto-swagger-project/issues"
  },
  "homepage": "https://github.com/Nabothdaniel/Auto-swagger-project#readme",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "prebuild": "npm run clean",
    "build": "tsc",
    "dev": "node --watch -r ts-node/register ./server.ts",
    "prepublishOnly": "npm run lint && npm run build && npm test -- --runInBand && npm pack --dry-run",
    "test": "jest",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"**/*.{ts,json,md}\"",
    "prepare": "husky install"
  },
  "keywords": [
    "express",
    "expressjs",
    "swagger",
    "swagger-ui",
    "openapi",
    "openapi3",
    "api-documentation",
    "api-docs",
    "rest-api",
    "typescript",
    "ts-morph",
    "documentation",
    "auto-generate",
    "zero-config"
  ],
  "author": "Daniel Naboth Agriga",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "swagger-ui-express": "^5.0.1",
    "ts-morph": "^27.0.2"
  },
  "peerDependencies": {
    "express": ">=4.17.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@types/express": "^5.0.5",
    "@types/jest": "^29.5.0",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.40.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "husky": "^8.0.3",
    "jest": "^29.5.0",
    "lint-staged": "^15.0.2",
    "prettier": "^3.0.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18"
  }
}
